{
  "pythonVersion": "3.11",
  "include": [
    "src",
    "api"
  ],
  "extraPaths": [
    "."
  ],
  "venvPath": ".",
  "venv": ".venv",
  "exclude": [
    ".venv",
    "__pycache__",
    "**/__pycache__",
    "**/*.pyc"
  ],
  "typeCheckingMode": "basic",
  "reportMissingModuleSource": "none",
  "reportMissingImports": "none"
}
