# InsightSwarm environment configuration template.
# Copy to `.env` and fill in your real values. Do NOT commit `.env`.

# ── LLM provider API keys (at least one working key required) ──────────────
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# ── Retrieval keys ─────────────────────────────────────────────────────────
TAVILY_API_KEY=
GOOGLE_CX=
GOOGLE_CLOUD=

# ── LLM model / tuning (optional) ──────────────────────────────────────────
LLM_TEMPERATURE=0.7
MAX_TOKENS=1000
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash
CEREBRAS_MODEL=llama3.1-8b
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Free-tier per-minute rate limits (provider count minus safety buffer)
RATE_LIMIT_GROQ=28
RATE_LIMIT_GEMINI=9
RATE_LIMIT_CEREBRAS=28
RATE_LIMIT_OPENROUTER=18

# ── Deployment / runtime configuration ─────────────────────────────────────
# Comma-separated list of allowed browser origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seconds to cool down a provider after a rate-limit hit
PROVIDER_COOLDOWN_SECONDS=90

# Offline fallback when all providers are exhausted ("true"/"false")
ENABLE_OFFLINE_FALLBACK=false

# Per-provider liveness probes ("true"/"false")
ENABLE_API_LIVENESS_PROBES=false

# ── Storage / cache ────────────────────────────────────────────────────────
INSIGHTSWARM_DB=insightswarm.db
INSIGHTSWARM_CHECKPOINT_DB=insightswarm_graph.db
SEMANTIC_CACHE_ENABLED=1
HF_LOCAL_ONLY=0
MAX_MEMORY_MB=500

# ── Frontend (Vite) ────────────────────────────────────────────────────────
# Override the backend proxy target (e.g. deploy behind a domain)
VITE_API_TARGET=http://127.0.0.1:8000
